<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flash Message Example</title>
</head>
<body>
    <h1>Flash Messages</h1>
    <% if (messages.length > 0) { %>
        <ul>
            <% messages.forEach(function(message) { %>
                <li><%= message %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No flash messages to display.</p>
    <% } %>
    <a href="/flash">Set Flash Message</a>
</body>
</html>
